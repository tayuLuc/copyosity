{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copyosity",
  "version": "1.0.4-fork16",
  "identifier": "com.vkovalskii.copyosity",
  "build": {
    "beforeDevCommand": "bash scripts/with-npm.sh npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/with-npm.sh npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost http: https:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tayuLuc/copyosity/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMDJCRUYzNDNFMDY5NjQKUldSa2FlQkQ4NzRDSCtHZUNnYXE4M0pRUGdJUE02cVY5djJLQnBXV3FDdlo2eEhKTnBlUWltL0wK"
    }
  }
}
